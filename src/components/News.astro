---
import news from '../content/news.json';
import { LANGS, formatDate, type Content, type Lang } from '../i18n';
interface Props { c: Content; lang: Lang; title: string; limit?: number }
const { c, lang, title, limit } = Astro.props;
const items = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, limit ?? news.length);
type L = keyof typeof c.press.languages;
---
<section class="section" aria-labelledby="news-title">
  <div class="container">
    <div class="news-head">
      <h2 id="news-title" class="h2 news-title">{title}</h2>
      <slot />
    </div>
    <ul class="rows">
      {items.map((n) => (
        <li data-reveal>
          <a class="row" href={n.url} hreflang={LANGS[n.articleLang as Lang]?.lang ?? n.articleLang}>
            <time class="date" datetime={n.date}>{formatDate(n.date, lang)}</time>
            <span class="headline">{n.title[lang]}</span>
            <span class="source">
              {n.source[lang]}
              {n.articleLang !== lang && <span class="lang-note">{c.press.languages[n.articleLang as L]}</span>}
              <span class="visually-hidden">, {c.press.external}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .news-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 32px;
  }
  .news-title { margin-top: 0; }
  .row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) 220px;
    gap: 32px;
    padding: 24px 0;
    color: var(--ink);
  }
  .row:hover { text-decoration: none; }
  .row:hover .headline {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .date { color: var(--ink-3); }
  .headline { font-size: 20px; line-height: 1.35; }
  .source { text-align: right; font-size: var(--fs-small); color: var(--ink-3); }
  .lang-note { display: block; font-size: var(--fs-label); }
  @media (max-width: 900px) {
    .row { grid-template-columns: minmax(0, 1fr); gap: 6px; padding: 20px 0; }
    .source { text-align: left; }
    .lang-note { display: inline; margin-left: 6px; }
    .headline { font-size: 18px; }
  }
</style>
