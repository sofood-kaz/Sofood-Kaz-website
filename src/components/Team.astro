---
import Photo from './Photo.astro';
import { findPortrait } from '../lib/images';
import team from '../content/team.json';
import type { Content, Lang } from '../i18n';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const leads = team.filter((m) => m.lead);
const others = team.filter((m) => !m.lead);
---
<section class="leads-section band-white" aria-label={c.team.lead}>
  <div class="container">
    <ul class="leads">
      {leads.map((m) => (
        <li data-reveal>
          <Photo image={findPortrait(m.id)} alt={m.name[lang]} ratio="4 / 5" inside={c.team.photo}
            class="portrait" sizes="(max-width: 700px) 100vw, 590px" widths={[480, 720, 1180]} eager />
          <p class="role">{m.role[lang]}</p>
          <h2 class="lead-name">{m.name[lang]}</h2>
          {m.focus[lang] && <p class="focus">{m.focus[lang]}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

{others.length > 0 && (
  <section class="section" aria-labelledby="others-title">
    <div class="container">
      <div class="others-head">
        <h2 id="others-title" class="h2 others-title">{c.team.othersTitle}</h2>
        {c.team.intro && <p class="intro">{c.team.intro}</p>}
      </div>
      <ul class="team">
        {others.map((m) => (
          <li data-reveal>
            <Photo image={findPortrait(m.id)} alt={m.name[lang]} ratio="4 / 5" inside={c.team.photo}
              class="portrait" sizes="(max-width: 640px) 50vw, (max-width: 900px) 33vw, 280px" widths={[280, 420, 560]} />
            <h3>{m.name[lang]}</h3>
            <p class="member-role">{m.role[lang]}</p>
            {m.focus[lang] && <p class="member-focus">{m.focus[lang]}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .leads-section { padding-block: 72px 96px; }
  .leads {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px var(--col-gap);
  }
  .leads :global(.portrait), .team :global(.portrait) { border-radius: 2px; }
  .leads :global(.portrait) { max-width: 440px; }
  .role {
    margin-top: 24px;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--green);
  }
  .lead-name {
    margin-top: 10px;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1.08;
  }
  .focus {
    margin-top: 12px;
    color: var(--ink-2);
  }
  .others-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 40px;
  }
  .others-title { margin-top: 0; }
  .intro { max-width: 420px; color: var(--ink-2); }
  .team {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 32px;
  }
  .team h3 {
    margin: 16px 0 4px;
    font-size: 20px;
    line-height: 1.3;
  }
  .member-role { font-size: var(--fs-small); color: var(--ink-2); }
  .member-focus { margin-top: 4px; font-size: var(--fs-small); color: var(--ink-3); }
  @media (max-width: 900px) {
    .leads-section { padding-block: 48px 64px; }
    .team { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; }
  }
  @media (max-width: 700px) {
    .leads { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .team { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .team h3 { font-size: 17px; }
  }
</style>
