---
import type { Content } from '../i18n';
interface Props { c: Content }
const { timeline, progress } = Astro.props.c.factory;
type Status = keyof typeof timeline.status;
---
<section id="timeline" class="section band-white" aria-labelledby="timeline-title">
  <div class="container">
    <div class="progress" data-reveal role="img" aria-label={`${progress.label}: ${progress.value}%. ${progress.text}`}>
      <div class="progress-top" aria-hidden="true">
        <span class="progress-value">{progress.value}%</span>
        <span class="progress-text"><strong>{progress.label}</strong><br />{progress.text}</span>
      </div>
      <div class="bar" aria-hidden="true"><span class="bar-fill" style={`--value: ${progress.value}%`}></span></div>
    </div>
    <p class="label">{timeline.label}</p>
    <h2 id="timeline-title" class="h2 timeline-title">{timeline.title}</h2>
    <ol class="rows timeline">
      {timeline.items.map((item) => (
        <li class:list={['row', `is-${item.status}`]} data-reveal>
          <span class="date">{item.date}</span>
          <span class="event">{item.text}</span>
          <span class="status">{timeline.status[item.status as Status]}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .progress { margin-bottom: 88px; }
  .progress-top {
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }
  .progress-value {
    font-family: var(--serif);
    font-size: clamp(4.5rem, 3rem + 6vw, 8rem);
    line-height: 0.9;
    color: var(--green);
  }
  .progress-text { padding-bottom: 6px; color: var(--ink-2); }
  .progress-text strong { font-weight: 600; color: var(--ink); }
  .bar {
    height: 10px;
    margin-top: 24px;
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .bar-fill {
    display: block;
    height: 100%;
    width: var(--value);
    background: var(--green);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .progress .bar-fill { width: 0; transition: width 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s; }
    :global(html.js) .progress.is-visible .bar-fill { width: var(--value); }
  }
  .timeline-title { margin-bottom: 48px; }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 160px;
    gap: 32px;
    padding: 22px 0;
  }
  .date { font-weight: 600; }
  .status {
    text-align: right;
    color: var(--ink-3);
  }
  .is-now .status {
    color: var(--green);
    font-weight: 600;
  }
  .is-now .event { font-weight: 500; }
  @media (max-width: 900px) {
    .timeline-title { margin-bottom: 32px; }
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
      padding: 18px 0;
    }
    .date { grid-column: 1; grid-row: 1; }
    .status { grid-column: 2; grid-row: 1; }
    .event { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
