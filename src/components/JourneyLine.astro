---
/* The campaign drawing "from farm to shelf": one line, milk - cheese - shelf. Decorative. */
import Line from './Line.astro';
---
<div class="journey" data-reveal>
  <Line name="journey" draw />
</div>

<style>
  .journey {
    padding: clamp(20px, 3.4vw, 40px) var(--gutter) clamp(14px, 2.4vw, 28px);
    background: var(--paper);
    color: var(--land);
    border-bottom: 2px solid var(--milk);
  }
  .journey :global(svg) { width: auto; max-width: 100%; height: auto; max-height: 190px; margin-inline: auto; }
  /* Keep the band itself in place; only the line is drawn. */
  :global(html.js) .journey[data-reveal] { opacity: 1; transform: none; }
</style>
