---
import type { Content } from '../i18n';
import groupLogo from '../assets/logos/solico-group-white.png';
import logo from '../assets/logos/sofood-kaz-white.png';
interface Props { c: Content }
const { c } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer band-ink on-dark">
  <div class="container footer-inner">
    <p class="footer-brand"><a class="footer-group" href="https://solico-group.com/" target="_blank" rel="noopener"><img src={groupLogo.src} width="96" height="35" alt={c.solico.logoAlt} loading="lazy" /></a><img class="footer-logo" src={logo.src} width="867" height="154" alt={c.brand.name} loading="lazy" /> <span>{c.brand.tagline}</span></p>
    <p class="footer-legal">
      <span>© {year} {c.footer.company}</span>
      <span>{c.footer.bin}</span>
      <span>{c.footer.address}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer { padding: 28px 0 30px; border-block: 0; border-top: 2px solid var(--milk); }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 32px;
    font-size: 14px;
    color: var(--on-ink-3);
  }
  .footer-brand { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .footer-group { display: block; height: 35px; margin-right: 6px; transition: opacity 0.2s ease; }
  .footer-group img { display: block; width: auto; height: 100%; }
  .footer-group:hover { opacity: 0.78; }
  .footer-logo { width: auto; height: 28px; }
  .footer-name {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--on-dark);
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  @media (max-width: 900px) {
    .site-footer { padding: 32px 0 32px; }
    .footer-legal { flex-direction: column; }
  }
</style>
