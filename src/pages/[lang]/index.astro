---
import Base from '../../layouts/Base.astro';
import MapSheet from '../../components/MapSheet.astro';
import ScaleSteps from '../../components/ScaleSteps.astro';
import JourneyLine from '../../components/JourneyLine.astro';
import HomeIndex from '../../components/HomeIndex.astro';
import News from '../../components/News.astro';
import Arrow from '../../components/Arrow.astro';
import { LANG_CODES, pagePath, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const c = t(lang);
---
<Base lang={lang} page="home" sheet>
  <MapSheet c={c} lang={lang} />
  <JourneyLine />
  <ScaleSteps c={c} lang={lang} />
  <HomeIndex c={c} lang={lang} />
  <News c={c} lang={lang} title={c.home.pressTitle} limit={3}>
    <a class="more-link" href={pagePath(lang, 'press')}>{c.home.pressLink}<Arrow /></a>
  </News>
</Base>
