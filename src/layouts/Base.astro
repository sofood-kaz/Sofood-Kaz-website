---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { LANGS, t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);

// Preload the font files the first screen needs in this language.
// All of them arrive together, so the page is laid out once, not per font.
const fonts = lang === 'en'
  ? ['golos-latin', 'playfair-latin']
  : lang === 'kz'
    ? ['golos-cyrillic', 'golos-cyrillic-ext', 'golos-latin', 'playfair-cyrillic', 'playfair-cyrillic-ext', 'playfair-latin']
    : ['golos-cyrillic', 'golos-latin', 'playfair-cyrillic', 'playfair-latin'];
---
<!doctype html>
<html lang={LANGS[lang].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {fonts.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <Seo lang={lang} c={c} />
    <meta name="theme-color" content="#F6F3EC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{c.nav.skip}</a>
    <Header lang={lang} c={c} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer c={c} />

    <script is:inline>
      (function () {
        // Phone menu
        var btn = document.querySelector('.menu-button');
        var nav = document.getElementById('site-nav');
        if (btn && nav) {
          btn.hidden = false;
          var label = btn.querySelector('.menu-button-text');
          var set = function (open) {
            btn.setAttribute('aria-expanded', String(open));
            nav.classList.toggle('is-open', open);
            if (label) label.textContent = open ? btn.dataset.close : btn.dataset.open;
          };
          btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
          nav.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
          });
          window.matchMedia('(min-width: 901px)').addEventListener('change', function (e) { if (e.matches) set(false); });
        }

        // Language links keep the section the reader is on.
        var links = document.querySelectorAll('[data-lang-link]');
        var sections = document.querySelectorAll('main > section[id]');
        if ('IntersectionObserver' in window && links.length) {
          var update = function (id) {
            links.forEach(function (a) {
              var base = a.getAttribute('href').split('#')[0];
              a.setAttribute('href', id && id !== 'top' ? base + '#' + id : base);
            });
          };
          if (location.hash) update(location.hash.slice(1));
          var spy = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) update(en.target.id); });
          }, { rootMargin: '-40% 0px -55% 0px' });
          sections.forEach(function (s) { spy.observe(s); });
        }

        // Subtle fade-in on scroll (skipped when reduced motion is requested).
        var items = document.querySelectorAll('[data-reveal]');
        var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
            });
          }, { rootMargin: '0px 0px -6% 0px' });
          items.forEach(function (el) { io.observe(el); });
        } else {
          items.forEach(function (el) { el.classList.add('is-visible'); });
        }
      })();
    </script>
  </body>
</html>
