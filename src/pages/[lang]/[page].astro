---
/* All inner pages: /ru/solico/, /ru/history/, /ru/team/, /ru/factory/,
   /ru/careers/, /ru/press/, /ru/contact/ (and the same under /kz/, /en/). */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Arrow from '../../components/Arrow.astro';
import SolicoStory from '../../components/SolicoStory.astro';
import Founder from '../../components/Founder.astro';
import Brands from '../../components/Brands.astro';
import HistoryTimeline from '../../components/HistoryTimeline.astro';
import Team from '../../components/Team.astro';
import Project from '../../components/Project.astro';
import Chain from '../../components/Chain.astro';
import Timeline from '../../components/Timeline.astro';
import Releases from '../../components/Releases.astro';
import News from '../../components/News.astro';
import Contact from '../../components/Contact.astro';
import { LANG_CODES, PAGES, pagePath, t, type Lang, type Page } from '../../i18n';

export function getStaticPaths() {
  return LANG_CODES.flatMap((lang) => PAGES.map((page) => ({ params: { lang, page } })));
}

const lang = Astro.params.lang as Lang;
const page = Astro.params.page as Page;
const c = t(lang);
---
<Base lang={lang} page={page}>
  {page === 'solico' && (
    <>
      <PageHead label={c.solico.label} title={c.solico.title} lead={c.solico.lead} />
      <SolicoStory c={c} />
      <Founder c={c} />
      <section class="section history-link" aria-labelledby="history-link-title">
        <div class="container">
          <p class="label">{c.solico.historyLink.label}</p>
          <h2 id="history-link-title" class="h2">{c.solico.historyLink.title}</h2>
          <a class="more-link" href={pagePath(lang, 'history')}>{c.solico.historyLink.link}<Arrow /></a>
        </div>
      </section>
      <Brands c={c} />
    </>
  )}

  {page === 'history' && (
    <>
      <PageHead label={c.history.label} title={c.history.title} lead={c.history.lead} />
      <HistoryTimeline c={c} />
      <Brands c={c} wipe />
    </>
  )}

  {page === 'team' && (
    <>
      <PageHead label={c.team.label} title={c.team.title} lead={c.team.lead} />
      <Team c={c} lang={lang} />
    </>
  )}

  {page === 'factory' && (
    <>
      <PageHead label={c.factory.label} title={c.factory.title} lead={c.factory.lead} />
      <Project c={c} />
      <Chain c={c} />
      <Timeline c={c} />
    </>
  )}

  {page === 'careers' && (
    <div class="careers">
      <PageHead label={c.careers.label} title={c.careers.title} lead={c.careers.lead} />
    </div>
  )}

  {page === 'press' && (
    <>
      <PageHead label={c.press.label} title={c.press.title} />
      <Releases c={c} lang={lang} />
      <News c={c} lang={lang} title={c.press.newsTitle} />
    </>
  )}

  {page === 'contact' && <Contact c={c} main />}
</Base>

<style>
  .history-link .h2 { max-width: 760px; margin-bottom: 24px; }
  .careers { min-height: 46vh; }
</style>
