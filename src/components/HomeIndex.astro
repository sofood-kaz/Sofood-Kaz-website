---
import Arrow from './Arrow.astro';
import { pagePath, type Content, type Lang, type PageKey } from '../i18n';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
---
<section class="section band-white" aria-labelledby="index-title">
  <div class="container">
    <h2 id="index-title" class="label">{c.home.indexLabel}</h2>
    <ul class="rows index">
      {c.home.index.map((item) => (
        <li data-reveal>
          <a href={pagePath(lang, item.page as PageKey)}>
            <span class="title">{item.title}</span>
            <span class="text">{item.text}</span>
            <span class="arrow"><Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .index { margin-top: 24px; }
  .index a {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 40px;
    gap: 32px;
    align-items: baseline;
    padding: 26px 0;
    color: var(--ink);
  }
  .index a:hover { text-decoration: none; }
  .title {
    font-family: var(--serif);
    font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.25rem);
    line-height: 1.1;
    transition: color 0.2s ease;
  }
  .index a:hover .title { color: var(--green); }
  .text { color: var(--ink-2); }
  .arrow {
    justify-self: end;
    align-self: center;
    color: var(--green);
    transition: transform 0.2s ease;
  }
  .index a:hover .arrow { transform: translateX(6px); }
  @media (max-width: 900px) {
    .index a {
      grid-template-columns: minmax(0, 1fr) 28px;
      gap: 6px 16px;
      padding: 20px 0;
    }
    .text { grid-column: 1; grid-row: 2; }
    .arrow { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
