---
import { Picture } from 'astro:assets';
import solicoMark from '../assets/logos/solico-mark.png';
import kallehLogo from '../assets/logos/kalleh.png';
import type { Content } from '../i18n';
interface Props { c: Content }
const { solico } = Astro.props.c;
---
<section id="solico" class="section band-green on-dark" aria-labelledby="solico-title">
  <div class="container">
    <div class="grid">
      <div class="span-7">
        <p class="label">{solico.label}</p>
        <h2 id="solico-title" class="solico-title">{solico.title}</h2>
        <div class="solico-text">
          {solico.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <p class="founder">{solico.founder}</p>
      </div>

      <div class="span-5">
        <h3 class="visually-hidden">{solico.factsLabel}</h3>
        <dl class="facts">
          {solico.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
        <p class="source">{solico.source}</p>
        <div class="logos">
          <span class="logo-disc">
            <Picture src={solicoMark} alt={solico.logoSolico} height={52} densities={[1, 2]} formats={['avif', 'webp']} />
          </span>
          <Picture src={kallehLogo} alt={solico.logoKalleh} height={56} densities={[1, 2]} formats={['avif', 'webp']} />
        </div>
      </div>
    </div>

    <div class="history" data-reveal>
      <h3 class="label">{solico.historyLabel}</h3>
      <ol>
        {solico.history.map((h) => (
          <li><span class="year">{h.year}</span><span class="event">{h.text}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .band-green { padding-block: 104px; }
  .solico-title {
    margin-top: 20px;
    font-size: var(--fs-h2-big);
    line-height: 1.06;
  }
  .solico-text {
    max-width: 600px;
    margin-top: 28px;
    font-size: 18px;
    color: var(--on-green-2);
  }
  .solico-text p + p { margin-top: 14px; }
  .founder {
    max-width: 600px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-on-dark);
    font-size: var(--fs-small);
    color: var(--on-green-2);
  }
  .facts { border-top: 1px solid rgba(246, 243, 236, 0.45); }
  .facts div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule-on-dark);
  }
  .facts dt { color: var(--on-green-3); }
  .facts dd {
    font-family: var(--serif);
    font-size: 34px;
    line-height: 1.1;
    white-space: nowrap;
  }
  .source {
    margin-top: 12px;
    font-size: var(--fs-label);
    color: var(--on-green-3);
  }
  .logos {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }
  .logo-disc {
    display: inline-flex;
    padding: 4px;
    background: var(--white);
    border-radius: 50%;
  }
  .logos :global(img) { width: auto; height: 52px; }
  .history { margin-top: 80px; }
  .history ol {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: 16px;
    border-top: 1px solid rgba(246, 243, 236, 0.45);
  }
  .history li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 16px 0;
    border-left: 1px solid var(--rule-on-dark);
  }
  .history li:first-child { padding-left: 0; border-left: 0; }
  .year {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1;
  }
  .event {
    font-size: var(--fs-small);
    color: var(--on-green-2);
  }
  @media (max-width: 900px) {
    .band-green { padding-block: 72px; }
    .history { margin-top: 56px; }
    .history ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .history li { padding: 16px 0 18px 16px; }
    .history li:nth-child(odd) { padding-left: 0; border-left: 0; }
    .history li:nth-child(n + 3) { border-top: 1px solid var(--rule-on-dark); }
  }
</style>
