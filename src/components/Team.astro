---
import Photo from './Photo.astro';
import { findPortrait } from '../lib/images';
import team from '../content/team.json';
import type { Content, Lang } from '../i18n';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
---
<section id="team" class="section band-white" aria-labelledby="team-title">
  <div class="container">
    <div class="team-head">
      <div>
        <p class="label">{c.team.label}</p>
        <h2 id="team-title" class="h2">{c.team.title}</h2>
      </div>
      {c.team.intro && <p class="intro">{c.team.intro}</p>}
    </div>
    <ul class="team">
      {team.map((m) => (
        <li data-reveal>
          <Photo image={findPortrait(m.id)} alt={m.name[lang]} ratio="4 / 5" inside={c.team.photo}
            class="portrait" sizes="(max-width: 640px) 50vw, (max-width: 900px) 33vw, 280px" widths={[280, 420, 560]} />
          <h3>{m.name[lang]}</h3>
          <p class="role">{m.role[lang]}</p>
          {m.focus[lang] && <p class="focus">{m.focus[lang]}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 48px;
  }
  .intro {
    max-width: 420px;
    color: var(--ink-2);
  }
  .team {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 32px;
  }
  .team :global(.portrait) { border-radius: 2px; }
  .team h3 {
    margin: 16px 0 4px;
    font-size: 20px;
    line-height: 1.3;
  }
  .role {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .focus {
    margin-top: 4px;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .team-head { margin-bottom: 32px; }
    .team { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; }
  }
  @media (max-width: 640px) {
    .team { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .team h3 { font-size: 17px; }
  }
</style>
