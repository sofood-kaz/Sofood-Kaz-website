---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { LANGS, t, type Lang, type PageKey } from '../i18n';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const c = t(lang);

// Preload the font files the first screen needs in this language.
// All of them arrive together, so the page is laid out once, not per font.
const fonts = lang === 'en'
  ? ['golos-latin', 'playfair-latin']
  : lang === 'kz'
    ? ['golos-cyrillic', 'golos-cyrillic-ext', 'golos-latin', 'playfair-cyrillic', 'playfair-cyrillic-ext', 'playfair-latin']
    : ['golos-cyrillic', 'golos-latin', 'playfair-cyrillic', 'playfair-latin'];
---
<!doctype html>
<html lang={LANGS[lang].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {fonts.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <Seo lang={lang} c={c} page={page} />
    <meta name="theme-color" content="#F6F3EC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{c.nav.skip}</a>
    <Header lang={lang} c={c} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer c={c} />

    <script is:inline>
      (function () {
        var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var hasIO = 'IntersectionObserver' in window;

        // Phone menu
        var btn = document.querySelector('.menu-button');
        var nav = document.getElementById('site-nav');
        if (btn && nav) {
          btn.hidden = false;
          var label = btn.querySelector('.menu-button-text');
          var set = function (open) {
            btn.setAttribute('aria-expanded', String(open));
            nav.classList.toggle('is-open', open);
            if (label) label.textContent = open ? btn.dataset.close : btn.dataset.open;
          };
          btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
          });
          window.matchMedia('(min-width: 1121px)').addEventListener('change', function (e) { if (e.matches) set(false); });
        }

        // Subtle fade-in on scroll (skipped when reduced motion is requested).
        var items = document.querySelectorAll('[data-reveal]');
        if (!calm && hasIO) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
            });
          }, { rootMargin: '0px 0px -6% 0px' });
          items.forEach(function (el) { io.observe(el); });
        } else {
          items.forEach(function (el) { el.classList.add('is-visible'); });
        }

        // Brands row: pause button.
        document.querySelectorAll('[data-marquee-toggle]').forEach(function (b) {
          var row = b.closest('section').querySelector('[data-marquee]');
          if (!row || calm) return;
          b.hidden = false;
          b.addEventListener('click', function () {
            var paused = row.classList.toggle('is-paused');
            b.setAttribute('aria-pressed', String(paused));
            b.querySelector('span').textContent = paused ? b.dataset.play : b.dataset.pause;
          });
        });

        // History: the pinned year follows the event in the middle of the screen.
        var hist = document.querySelector('[data-history]');
        var big = hist && hist.querySelector('[data-history-year]');
        var events = hist ? Array.prototype.slice.call(hist.querySelectorAll('.event')) : [];
        if (hist && hasIO && !calm) {
          var swapTimer;
          var activate = function (el) {
            events.forEach(function (ev) {
              ev.classList.toggle('is-active', ev === el);
              ev.classList.toggle('is-past', events.indexOf(ev) < events.indexOf(el));
            });
            if (big && big.textContent !== el.dataset.year) {
              big.classList.add('is-swapping');
              clearTimeout(swapTimer);
              swapTimer = setTimeout(function () {
                big.textContent = el.dataset.year;
                big.classList.remove('is-swapping');
              }, 180);
            }
          };
          var spy = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) activate(en.target); });
          }, { rootMargin: '-45% 0px -45% 0px' });
          events.forEach(function (ev) { spy.observe(ev); });
        } else {
          events.forEach(function (ev) { ev.classList.add('is-past'); });
        }

        // Scroll-linked values: reading progress, history line, brands wipe.
        var root = document.documentElement;
        var list = hist && hist.querySelector('.events');
        var wipe = document.querySelector('[data-wipe]');
        var ticking = false;
        var clamp = function (v) { return Math.max(0, Math.min(1, v)); };
        var update = function () {
          ticking = false;
          var vh = window.innerHeight;
          var max = root.scrollHeight - vh;
          root.style.setProperty('--read', max > 0 ? clamp(window.scrollY / max).toFixed(4) : '0');
          if (calm) return;
          if (list) {
            var r = list.getBoundingClientRect();
            list.style.setProperty('--fill', clamp((vh * 0.5 - r.top) / r.height).toFixed(4));
          }
          if (wipe) {
            var w = wipe.getBoundingClientRect();
            wipe.style.setProperty('--wipe', clamp((vh - w.top) / (vh * 0.55)).toFixed(4));
          }
        };
        window.addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>
  </body>
</html>
